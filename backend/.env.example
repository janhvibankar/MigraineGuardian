# MigraineGuardian Backend Environment Configuration

# Server Port & Client Origin CORS Settings
PORT=5001
# LOCAL: http://localhost:3000 | PRODUCTION: https://migraineguardian.vercel.app (comma-separated origins supported)
CLIENT_ORIGIN=http://localhost:3000,https://migraineguardian.vercel.app

# FastAPI ML Service Integration
# LOCAL: http://127.0.0.1:8000 | PRODUCTION: https://migraineguardian-ml.onrender.com
ML_SERVICE_URL=http://127.0.0.1:8000
# (Legacy alias — ML_SERVICE_URL takes precedence if set)
FASTAPI_BASE_URL=http://127.0.0.1:8000

# RAG Chatbot Service Integration
# PRODUCTION: https://migraine-rag-chatbot.onrender.com/api/chat
RAG_SERVICE_URL=https://migraine-rag-chatbot.onrender.com/api/chat


# Firebase Admin SDK Configuration Options:
# Option 1: Path to Service Account JSON Key file
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./config/firebase-service-account.json

# Option 2: Individual Firebase Service Account Credentials
# (Alternative to file path, useful for cloud deployments like Vercel/Render/Heroku)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
