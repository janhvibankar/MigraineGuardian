# MigraineGuardian Frontend Environment Variables

# Node.js Express API Gateway Base URL
# LOCAL: http://localhost:5000/api | PRODUCTION: https://migraineguardian-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# RAG Chatbot Backend Base URL
# NOTE: chatService.js strips the /api/chat suffix from VITE_CHATBOT_API_URL automatically
# when constructing requests. Always provide the full /api/chat URL here.
VITE_RAG_API_URL=http://localhost:5000
VITE_CHATBOT_API_URL=https://migraine-rag-chatbot.onrender.com/api/chat

# Firebase Authentication Web Client Config (Optional overrides)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=migraineguardian.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=migraineguardian
VITE_FIREBASE_STORAGE_BUCKET=migraineguardian.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
